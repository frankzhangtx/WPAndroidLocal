{
  "schemaVersion": 1,
  "id": "TASK-EXAMPLE-001",
  "title": "Replace with one small, observable behavior change",
  "designApproved": true,
  "planPath": "docs/plans/TASK-EXAMPLE-001.md",
  "ambiguityPolicy": "BLOCKED",
  "maxFixLoops": 1,
  "maxChangedFiles": 4,
  "allowedPaths": [
    "WordPress/src/main/**",
    "libs/analytics/src/main/**",
    "libs/editor/src/main/**",
    "libs/fluxc/src/main/**",
    "libs/image-editor/src/main/**",
    "libs/mocks/src/main/**",
    "libs/networking/src/main/**",
    "libs/posttypes/src/main/**",
    "WordPress/src/test/**",
    "WordPress/src/androidTest/**",
    "libs/analytics/src/test/**",
    "libs/analytics/src/androidTest/**",
    "libs/editor/src/test/**",
    "libs/editor/src/androidTest/**",
    "libs/fluxc/src/test/**",
    "libs/fluxc/src/androidTest/**",
    "libs/image-editor/src/test/**",
    "libs/image-editor/src/androidTest/**",
    "libs/mocks/src/test/**",
    "libs/mocks/src/androidTest/**",
    "libs/networking/src/test/**",
    "libs/networking/src/androidTest/**",
    "libs/posttypes/src/test/**",
    "libs/posttypes/src/androidTest/**"
  ],
  "forbiddenPaths": [
    ".automation-worktree-allowlist",
    ".opencode/**",
    ".automation-plugin/**",
    "automation/**",
    "scripts/automation/**",
    "opencode.json",
    "opencode.jsonc",
    "AGENTS.md",
    "gradle/**",
    "gradlew",
    "gradlew.bat",
    "settings.gradle",
    "settings.gradle.kts",
    "build.gradle",
    "build.gradle.kts",
    "**/build.gradle",
    "**/build.gradle.kts",
    "WordPress/build.gradle",
    "libs/analytics/build.gradle",
    "libs/editor/build.gradle",
    "libs/fluxc/build.gradle",
    "libs/image-editor/build.gradle",
    "libs/mocks/build.gradle",
    "libs/networking/build.gradle",
    "libs/posttypes/build.gradle"
  ],
  "allowedSuperpowers": [
    "test-driven-development",
    "systematic-debugging",
    "verification-before-completion"
  ],
  "acceptanceCriteria": [
    "Replace with an observable input/output or UI behavior",
    "A focused test demonstrates the behavior and is captured RED before implementation",
    "Unit tests, debug build, and lint all pass"
  ],
  "nonGoals": [
    "Do not refactor unrelated screens",
    "Do not upgrade dependencies or Gradle configuration"
  ],
  "targetTests": [
    {
      "gradleTask": ":WordPress:testWordpressDebugUnitTest",
      "filter": "org.wordpress.android.ReplaceWithFocusedTest"
    }
  ],
  "deviceTestsRequired": false,
  "testPolicy": "required",
  "testPolicyReason": "Behavior changes require a focused regression test"
}

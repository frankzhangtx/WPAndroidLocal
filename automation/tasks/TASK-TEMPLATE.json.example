  "allowedWorkflowSkills": [
    "android-orchestrator-test-driven-development",
    "android-orchestrator-systematic-debugging",
    "android-orchestrator-verification-before-completion"
  ],
  "acceptanceCriteria": [
    "Replace with an observable input/output or UI behavior"
  ],
  "nonGoals": [
    "Do not refactor unrelated screens",
    "Do not upgrade dependencies or Gradle configuration"
  ],
  "targetTests": [
    {
      "gradleTask": ":WordPress:testJetpackDebugUnitTest",
      "filter": "org.wordpress.android.ReplaceWithFocusedTest"
    }
  ],
  "deviceTestsRequired": false,
  "testPolicy": "required",
  "testPolicyReason": "Behavior changes require a focused regression test",
  "verification": {
    "version": 2,
    "maxPreparationFixes": 1,
    "cases": [
      {
        "id": "FOCUSED-BEHAVIOR",
        "criterion": 1,
        "intent": "change",
        "before": "fail",
        "after": "pass",
        "source": "userRequirement",
        "test": {
          "target": 0,
          "className": "org.wordpress.android.ReplaceWithFocusedTest",
          "name": "replace with observable behavior"
        },
        "expectedFailure": {
          "type": "java.lang.AssertionError",
          "origin": {
            "className": "org.wordpress.android.ReplaceWithFocusedTest",
            "methodName": "replace with observable behavior"
          }
        }
      }
    ],
    "inventory": {
      "mode": "focusedBaseline",
      "existingSkips": "reject",
      "emptyBaseline": "reject"
    },
    "scope": {
      "version": 1,
      "mode": "affected",
      "variants": "debug",
      "maxManualRetries": 1
    }
  },
  "recovery": {
    "version": 1,
    "scope": "baseline",
    "maxEnvironmentRetries": 2,
    "maxManualRetries": 1,
    "maxElapsedMs": 1800000,
    "initialDelayMs": 2000,
    "maxDelayMs": 30000,
    "maxSameFailureRetries": 2
  },
  "execution": {
    "version": 1,
    "maxRunMs": 7200000,
    "maxStageMs": 3600000,
    "terminationGraceMs": 10000
  },
  "stageRecovery": {
    "version": 1,
    "maxEnvironmentRetries": 2,
    "maxElapsedMs": 1800000,
    "initialDelayMs": 2000,
    "maxDelayMs": 30000,
    "maxSameFailureRetries": 2
  }
